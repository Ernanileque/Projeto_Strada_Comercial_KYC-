# Supabase — obtenha em Project Settings > API no painel do Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# DocuSign — módulo opera em modo simulado enquanto estas variáveis
# estiverem vazias (Fase 4)
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_PRIVATE_KEY=
DOCUSIGN_BASE_PATH=

# IA — leitura de documentos (Fase 1.5) e Validador Cadastral de
# Compliance (Fase 2). Sem preenchimento manual/análise manual
ANTHROPIC_API_KEY=

# Resend — envio automático da Proposta Comercial por e-mail ao criar um
# credenciamento (conta sandbox só envia para o e-mail cadastrado nela)
RESEND_API_KEY=

# CloudConvert — converte a Proposta Comercial de .docx para .pdf antes
# de anexar no e-mail, preservando a formatação do modelo aprovado
CLOUDCONVERT_API_KEY=
